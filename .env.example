# Google Form Configuration
# Get the form action URL from your Google Form's HTML source (view-source and find the form action)
GOOGLE_FORM_ACTION=

# For direct form submission (useful for static deployments like GitHub Pages)
NEXT_PUBLIC_GOOGLE_FORM_ACTION=
NEXT_PUBLIC_GOOGLE_FORM_DIRECT=

# Postgres — your database connection
DATABASE_URL=
DATABASE_URL_POOLED=

# Storage — S3-compatible object storage
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=