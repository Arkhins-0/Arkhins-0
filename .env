# Google Form Configuration
# Get the form action URL from your Google Form's HTML source (view-source and find the form action)
GOOGLE_FORM_ACTION=https://docs.google.com/forms/d/16WZFZkgAWlf35nCqFCNPKoB8GO9FUQqZQQ4ZRA9yyZM/formResponse

# For direct form submission (useful for static deployments like GitHub Pages)
NEXT_PUBLIC_GOOGLE_FORM_ACTION=https://docs.google.com/forms/d/16WZFZkgAWlf35nCqFCNPKoB8GO9FUQqZQQ4ZRA9yyZM/formResponse
NEXT_PUBLIC_GOOGLE_FORM_DIRECT=true